{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "timezone": "America/New_York",
  "minimumReleaseAge": "7 days",
  "minor": {
    "automerge": true
  },
  "patch": {
    "automerge": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "commitMessageAction": "lock file maintenance",
    "schedule": ["* 0-11 * * 1"]
  },
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"]
  },
  "osvVulnerabilityAlerts": true,
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Keep krypsis-io/.github shared workflows on main, never pin",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["krypsis-io/.github"],
      "pinDigests": false
    },
    {
      "description": "Automerge GitHub Actions minor and patch updates, grouped, with ci type to avoid version bumps",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "GitHub Actions",
      "commitMessagePrefix": "ci(deps):",
      "automerge": true
    },
    {
      "description": "Group annotated workflow tool versions (trivy, cosign, ...) with GitHub Actions updates",
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".github/workflows/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "GitHub Actions",
      "commitMessagePrefix": "ci(deps):",
      "automerge": true
    },
    {
      "description": "Group major GitHub Actions updates, ci type to avoid version bumps, manual review",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "groupName": "GitHub Actions (major)",
      "commitMessagePrefix": "ci(deps):",
      "automerge": false
    },
    {
      "description": "Wolfi-base image digests - grouped with lock file maintenance, merge Monday",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["cgr.dev/chainguard/wolfi-base"],
      "groupName": "Lock file maintenance",
      "automerge": true,
      "automergeSchedule": ["before 6am on Monday"]
    },
    {
      "description": "Require manual review for major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major"]
    }
  ],
  "customDatasources": {
    "apk-wolfi": {
      "defaultRegistryUrlTemplate": "https://cwaits6.github.io/apk-datasource/x86_64/{{packageName}}.json",
      "format": "json"
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update apk add name=version pins in Dockerfiles from the apk-datasource index",
      "managerFilePatterns": ["/(^|/)Dockerfile[^/]*$/"],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "apk\\s+add[^\\n\\\\]*(?:\\\\[^\\S\\n]*\\n[^\\n\\\\]*)*",
        "(?<depName>[a-zA-Z0-9][a-zA-Z0-9._+-]*)=(?<currentValue>\\d+[^\\s\\\\]+)"
      ],
      "datasourceTemplate": "custom.apk-wolfi",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Update workflow tool versions annotated with '# renovate: datasource=... depName=...' on the line above",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n\\s*[\\w-]+:\\s*[\"']?(?<currentValue>[^\\s\"']+)[\"']?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    }
  ]
}
